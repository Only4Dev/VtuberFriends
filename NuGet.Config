<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="discordnet-nightly" value="https://baget.discordnet.dev/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="discordnet-nightly"><package pattern="Discord.Net.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
